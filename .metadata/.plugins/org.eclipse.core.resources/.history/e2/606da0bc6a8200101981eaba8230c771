package com.tss.jpa.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.tss.jpa.Repositary.StudentRepositary;
import com.tss.jpa.entity.Student;

@Service
public class StudentServiceImp implements StudentService {

	@Autowired
	public StudentRepositary studentRepo;

	@Override
	public List<Student> getAllStudents() {
		return studentRepo.findAll();
	}



	@Override
	public void deleteStudent(int id) {
		  studentRepo.deleteById(id);
	}

	@Override
	public Student getStudentById(int id) {
		Optional<Student> student = studentRepo.findById(id);
		return student.orElse(null);
	}
	
	
	public List<Student> readStudent(String name) {
		return studentRepo.findByFirstName(name);
		
	}


	@Override
	public List<Student> readByName(String name) {
		return studentRepo.findByFirstName(name);
	}

}