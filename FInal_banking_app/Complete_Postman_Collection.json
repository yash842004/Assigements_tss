            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{customerToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/withdraw?accountId={{accountId}}&amount=100.00&description=ATM withdrawal",
