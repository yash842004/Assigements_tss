    {
      "name": "5. Unauthorized Access Tests",
      "item": [
        {
          "name": "❌ Customer - Try Access Admin Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer1Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "pending"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer cannot access admin endpoints', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response contains admin privileges required message', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.message).to.include('Admin privileges required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ No Token - Try Access Protected Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customer1Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customer1Id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated request is denied', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Invalid Token - Try Access Protected Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_token_here"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customer1Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customer1Id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid token is rejected', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
