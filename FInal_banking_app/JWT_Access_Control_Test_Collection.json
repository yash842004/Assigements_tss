{
  "info": {
    "name": "Banking App - JWT Access Control Tests",
    "description": "Test collection for JWT-based access control in the banking application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customer1Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer2Token", 
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "superAdminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer1Id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "customer2Id",
      "value": "2", 
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication Setup",
      "item": [
        {
          "name": "Customer 1 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/customer/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "customer", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('customer1Token', response.data.accessToken);",
                  "    console.log('Customer 1 token set');",
                  "} else {",
                  "    console.log('Customer 1 login failed');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer 2 Login",
