    {
      "name": "4. Admin Role-Based Access Tests",
      "item": [
        {
          "name": "❌ Regular Admin - Try Customer Approval (Super Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvalNotes\": \"Customer approved by regular admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/customers/{{customer1Id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "customers", "{{customer1Id}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Regular admin cannot approve customers', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response contains insufficient privileges message', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.message).to.include('Insufficient admin privileges');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✅ Super Admin - Customer Approval",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvalNotes\": \"Customer approved by super admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/customers/{{customer1Id}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "customers", "{{customer1Id}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Super admin can approve customers', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response confirms approval', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.message).to.include('approved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "✅ Regular Admin - Loan Approval (Allowed)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approvalNotes\": \"Loan approved by regular admin\",\n  \"interestRate\": 5.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "1", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Regular admin can approve loans', function () {",
