                  "});",
                  "",
                  "pm.test('Response confirms loan approval', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.message).to.include('approved');",
                  "});"
                ]
              }
            }
          ]
        }
