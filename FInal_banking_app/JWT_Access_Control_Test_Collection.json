    {
      "name": "2. Customer Access Control Tests",
      "item": [
        {
          "name": "✅ Customer 1 - Access Own Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer1Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customer1Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customer1Id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer can access own data', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains customer data', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "❌ Customer 1 - Try Access Customer 2 Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer1Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customer2Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customer2Id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer cannot access other customer data', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Response contains access denied message', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.false;",
                  "    pm.expect(response.message).to.include('Access denied');",
                  "});"
                ]
              }
            }
          ]
        },
