{
  "name": "🏦 3. Account Management Module",
  "description": "Account creation, management, and operations",
  "item": [
    {
      "name": "💳 Account Operations",
      "item": [
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"]
            },
            "description": "Create a new bank account"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('accountId', response.data.id);",
                  "    console.log('Account ID saved:', response.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}"]
            },
            "description": "Get account details by ID"
          }
        },
        {
          "name": "Get Accounts by Customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/customer/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "customer", "{{customerId}}"]
            },
            "description": "Get all accounts for a customer"
          }
        },
        {
          "name": "Get Account Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "balance"]
            },
            "description": "Get current account balance"
          }
        },
        {
          "name": "Get Account Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "summary"]
            },
            "description": "Get account summary with statistics"
          }
        }
      ]
    },
    {
      "name": "🔧 Account Status Management",
      "item": [
        {
          "name": "Close Account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "close"]
            },
            "description": "Close an account (balance must be zero)"
          }
        },
        {
          "name": "Reopen Account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{accountId}}/reopen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{accountId}}", "reopen"]
            },
            "description": "Reopen a closed account"
          }
        },
        {
          "name": "Get All Accounts (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts?page=0&size=10&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "id,asc"
                }
              ]
            },
            "description": "Get all accounts with pagination (Admin only)"
          }
        }
      ]
    }
  ]
}
